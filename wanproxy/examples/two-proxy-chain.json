{
  "$schema": "../config/schema.json",
  "caches": {
    "memory": {
      "type": "memory",
      "size": "128MB"
    }
  },
  "codecs": {
    "encode": {
      "mode": "zlib+xcodec",
      "cache": "memory",
      "compressorLevel": 6,
      "trackStatistics": true
    },
    "decode": {
      "mode": "zlib+xcodec",
      "cache": "memory",
      "compressorLevel": 6,
      "trackStatistics": true
    }
  },
  "proxies": [
    {
      "name": "client-side",
      "type": "tcp",
      "listen": {
        "host": "127.0.0.1",
        "port": 8330
      },
      "upstream": {
        "host": "127.0.0.1",
        "port": 8331
      },
      "peerCodec": "encode"
    },
    {
      "name": "server-side",
      "type": "tcp",
      "listen": {
        "host": "127.0.0.1",
        "port": 8331
      },
      "upstream": {
        "host": "127.0.0.1",
        "port": 8332
      },
      "interfaceCodec": "decode"
    }
  ],
  "monitor": {
    "listen": {
      "host": "127.0.0.1",
      "port": 8403
    }
  }
}
