{
  "name": "wanproxy-js",
  "version": "0.0.1",
  "description": "TypeScript migration of WANProxy core components.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wanproxy": "./dist/cli/index.js",
    "tack": "./dist/cli/tack.js",
    "xcdump": "./dist/cli/xcdump.js",
    "fwdproxy": "./dist/cli/fwdproxy.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "scriptc": "scriptc build ./src/index.ts -o ./build/wanproxy",
    "build": "rollup -c ./rollup.config.ts",
    "format": "prettier -w . --experimental-cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "wanproxy",
    "xcodec",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "prettier": "^3.9.10",
    "rollup": "^4.66.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
