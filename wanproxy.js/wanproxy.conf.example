# Example classic wanproxy.conf for the TypeScript port.
#
# Run it after `pnpm build`:
#   node dist/cli/index.js wanproxy.conf.example
#
# Topology: a client-side proxy (proxy0) encodes toward the WAN and feeds a
# server-side proxy (proxy1) that decodes, then a SOCKS proxy.  A monitor
# exports the configuration and status on port 9900.

# Set the log mask before anything else to keep startup quiet.
create log-mask catch-all
set catch-all.regex "^/"
set catch-all.mask INFO
activate catch-all

# Cache hierarchy: a primary in-memory cache and a secondary XCDFS disk
# cache shared by all peers, combined into a pair.
create cache memorycache0
set memorycache0.type Memory
set memorycache0.size 128MB
activate memorycache0

create cache diskcache0
set diskcache0.type Disk
set diskcache0.size 64MB
set diskcache0.path "wanproxy.xcache"
activate diskcache0

create cache cache0
set cache0.type Pair
set cache0.primary memorycache0
set cache0.secondary diskcache0
activate cache0

# Codec instances: XCodec with a zlib compressor and byte counters.
create codec codec0
set codec0.codec XCodec
set codec0.cache cache0
set codec0.compressor zlib
set codec0.compressor_level 6
set codec0.track_statistics true
activate codec0

create codec codec1
set codec1.codec XCodec
set codec1.cache cache0
set codec1.compressor zlib
set codec1.compressor_level 6
set codec1.track_statistics true
activate codec1

# Interfaces and peers.  $object.member references reuse earlier values.
create interface if0
set if0.family IP
set if0.host "127.0.0.1"
set if0.port "3300"
activate if0

create interface if1
set if1.family $if0.family
set if1.host $if0.host
set if1.port "3301"
activate if1

create interface if2
set if2.family $if0.family
set if2.host $if0.host
set if2.port "3302"
activate if2

create peer peer0
set peer0.family $if1.family
set peer0.host $if1.host
set peer0.port $if1.port
activate peer0

create peer peer1
set peer1.family $if2.family
set peer1.host $if2.host
set peer1.port $if2.port
activate peer1

# Client-side proxy: encodes toward the WAN (peer codec).
create proxy proxy0
set proxy0.type TCP-TCP
set proxy0.interface if0
set proxy0.interface_codec None
set proxy0.peer peer0
set proxy0.peer_codec codec0
activate proxy0

# Server-side proxy: decodes from the WAN (interface codec).
create proxy proxy1
set proxy1.type TCP-TCP
set proxy1.interface if1
set proxy1.interface_codec codec1
set proxy1.peer peer1
set proxy1.peer_codec None
activate proxy1

# SOCKS proxy fronting the decoded side.
create proxy-socks proxy-socks0
set proxy-socks0.interface if2
activate proxy-socks0

# Monitor on port 9900: HTML at /, text at /:text, JSON at /status.
create interface if3
set if3.family $if0.family
set if3.host $if0.host
set if3.port "9900"
activate if3

create monitor monitor0
set monitor0.interface if3
activate monitor0
